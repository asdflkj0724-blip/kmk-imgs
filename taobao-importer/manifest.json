{
  "manifest_version": 3,
  "name": "ワンクリック商品取り込み",
  "version": "2.1.0",
  "description": "いま自分で開いている商品ページ1件だけを、ボタンを押したときに取り込む汎用ツールです。自動巡回は行いません。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "この商品を取り込む"
  },
  "options_page": "options/options.html"
}
