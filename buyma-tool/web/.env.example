# ここに書いた値は見本です。実際の値は .env.local（Git に入れない）か Vercel の環境変数に入れてください。

# サイトの URL（Stripe の戻り先や、メールのリンクに使う）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（プロジェクトの Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API（サーバー側だけ。拡張機能には絶対に入れない）
ANTHROPIC_API_KEY=
# 使うモデル（指示書どおり Sonnet）。思考の深さ low / medium / high
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MINI_MONTHLY=
STRIPE_PRICE_MINI_YEARLY=
STRIPE_PRICE_LIGHT_MONTHLY=
STRIPE_PRICE_LIGHT_YEARLY=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Chrome 拡張の ID（chrome://extensions に出る 32 文字）。ログイン連携の送り先
NEXT_PUBLIC_EXTENSION_ID=

# 為替の毎日更新（Vercel Cron）を守る合言葉
CRON_SECRET=

# 特定商取引法に基づく表記（公開前に必ず実際の情報を入れる）
NEXT_PUBLIC_SELLER_NAME=（販売事業者名）
NEXT_PUBLIC_SELLER_ADDRESS=（所在地）
NEXT_PUBLIC_SELLER_PHONE=（電話番号）
NEXT_PUBLIC_SELLER_EMAIL=（メールアドレス）
NEXT_PUBLIC_SELLER_MANAGER=（運営責任者）

# BUYMA の商品名・説明文の文字数上限（仮の値。BUYMA の出品画面で確認して直す）
BUYMA_TITLE_MAX=60
BUYMA_DESCRIPTION_MAX=3000

# AI の費用（ドル）を円にするレート（赤字を防ぐ安全装置に使う）
USD_JPY=160
