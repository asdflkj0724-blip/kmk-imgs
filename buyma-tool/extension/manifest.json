{
  "manifest_version": 3,
  "name": "BUYMA出品支援（開発版）",
  "version": "0.3.0",
  "description": "通販サイトの商品ページから、BUYMAの出品画面にそのまま貼れる日本語の出品データと画像ZIPを作ります。BUYMAへの登録はご自身で行います。",
  "permissions": ["storage", "activeTab", "scripting", "downloads"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.vercel.app/*",
    "https://*.alicdn.com/*",
    "https://*.taobaocdn.com/*",
    "https://*.tbcdn.cn/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["https://*.vercel.app/*", "http://localhost:3000/*"]
  },
  "action": {
    "default_title": "この商品の情報を取る",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
